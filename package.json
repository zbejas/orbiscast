{
  "name": "orbiscast",
  "version": "1.3.3",
  "description": "Orbiscast project",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc",
    "build:web": "vite build --config web/vite.config.ts",
    "start:prod": "node dist/index.js",
    "typecheck": "npm run typecheck:api && npm run typecheck:web",
    "typecheck:api": "tsc --noEmit",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "admin": "tsx src/cli/admin.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "unicorn-magic": "^0.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/supertest": "^7.2.1",
    "@types/xml2js": "^0.4.14",
    "@vitest/coverage-v8": "^5.0.2",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@dank074/discord-video-stream": "^7.0.0",
    "@lng2004/discord.js-selfbot-v13": "^3.7.2",
    "axios": "^1.20.0",
    "better-auth": "^1.7.25",
    "better-sqlite3": "^13.2.0",
    "compression": "^1.8.2",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "winston": "^3.19.0",
    "winston-transport": "^4.9.0",
    "xml2js": "^0.6.2",
    "zod": "^4.6.7"
  }
}
